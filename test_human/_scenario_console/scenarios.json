        {
          "id": "vendors",
          "label": "Vendors",
          "database": "ERPDB",
          "sql": "SELECT LIFNR AS [Vendor], NAME1 AS [Name], ORT01 AS [City], REGIO AS [St], ZTERM AS [Terms], SMTP_ADDR AS [Email] FROM dbo.LFA1 WHERE LIFNR LIKE 'CGV%' ORDER BY LIFNR"
        },
        {
          "id": "pos",
          "label": "Purchase orders",
          "database": "ERPDB",
          "sql": "SELECT TOP 200 h.EBELN AS [PO], h.LIFNR AS [Vendor], h.BEDAT AS [Ordered], h.ZTERM AS [Terms], h.INCO1 AS [Inco], h.NETWR AS [Value], COUNT(p.EBELP) AS [Lines] FROM dbo.EKKO h LEFT JOIN dbo.EKPO p ON p.EBELN=h.EBELN WHERE h.EBELN LIKE 'CGPO-%' GROUP BY h.EBELN,h.LIFNR,h.BEDAT,h.ZTERM,h.INCO1,h.NETWR ORDER BY h.EBELN"
        },
        {
          "id": "receipts",
          "label": "Goods receipts",
          "database": "ERPDB",
          "sql": "SELECT TOP 200 EBELN AS [PO], EBELP AS [Line], BELNR AS [Material doc], MENGE AS [Qty], WRBTR AS [Value], BUDAT AS [Posted], XBLNR AS [Delivery note] FROM dbo.EKBE WHERE EBELN LIKE 'CGPO-%' AND VGABE='1' ORDER BY EBELN, EBELP"
        },
        {
          "id": "history",
          "label": "Posted history",
          "database": "ERPDB",
          "sql": "SELECT TOP 200 vendor_invoice_id AS [Invoice], vendor_name AS [Vendor], invoice_date AS [Date], po_ref AS [PO], total_amount AS [Total], status AS [Status] FROM dbo.CG_VendorInvoices WHERE source_channel='history' ORDER BY invoice_date DESC"
        },
        {
          "id": "gl",
          "label": "AP ledger",
          "database": "ERPDB",
          "sql": "SELECT TOP 200 gl_entry_id AS [Entry], transaction_date AS [Date], gl_account AS [Account], gl_account_name AS [Name], debit_amount AS [Debit], credit_amount AS [Credit], reference AS [Ref] FROM dbo.GeneralLedger WHERE created_by='seed_ap_book' ORDER BY gl_entry_id"
        }
