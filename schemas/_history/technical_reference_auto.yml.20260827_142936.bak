records:
  microservices:
    columns:
      excerpt: Verbatim text excerpt describing the service metric
      metric_type: Type of performance metric reported
      metric_unit: Unit of the performance metric
      metric_value: Value of the performance metric
      percentile: Percentile associated with the metric, if applicable
      service_name: Name of the microservice
      source_page: Page number(s) where this service is described
      source_pages: Page number(s) this row came from
    expected_rows: 8
    grain: one row per microservice or service component described with its performance/operational
      metric
    vocabulary:
      metric_type:
      - latency
      - throughput
      - requests_per_second
      - error_rate
      - cpu_utilization
      - memory_utilization
      - availability
